{
  "$defs": {
    "BlueprintNaming": {
      "additionalProperties": false,
      "description": "The YAML form of naming entries (no Python renderers).",
      "properties": {
        "device_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Text"
            },
            {
              "$ref": "#/$defs/Field"
            },
            {
              "$ref": "#/$defs/Join"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Description"
        },
        "device_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Text"
            },
            {
              "$ref": "#/$defs/Field"
            },
            {
              "$ref": "#/$defs/Join"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Label"
        },
        "endpoint_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Text"
            },
            {
              "$ref": "#/$defs/Field"
            },
            {
              "$ref": "#/$defs/Join"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint Description"
        },
        "endpoint_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Text"
            },
            {
              "$ref": "#/$defs/Field"
            },
            {
              "$ref": "#/$defs/Join"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint Label"
        },
        "inventory_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Text"
            },
            {
              "$ref": "#/$defs/Field"
            },
            {
              "$ref": "#/$defs/Join"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inventory Description"
        },
        "inventory_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Text"
            },
            {
              "$ref": "#/$defs/Field"
            },
            {
              "$ref": "#/$defs/Join"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inventory Label"
        }
      },
      "title": "BlueprintNaming",
      "type": "object"
    },
    "CatalogId": {
      "additionalProperties": false,
      "description": "Exact catalog id reference, e.g. ``{id: default}`` for the system SNMP configuration.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "CatalogId",
      "type": "object"
    },
    "Coordinates": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Coordinates",
      "type": "object"
    },
    "DevicePatch": {
      "additionalProperties": false,
      "description": "Inspect device fields (device targets only). Device label/description come from naming.",
      "properties": {
        "coordinates": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinates"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "icon_size": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "large",
                "medium",
                "small"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon Size"
        },
        "icon_type": {
          "anyOf": [
            {
              "enum": [
                "default",
                "none",
                "device",
                "camera",
                "monitor",
                "encoder",
                "decoder",
                "audioMixer",
                "videoMixer",
                "processingDevice",
                "transportStreamProcessor",
                "mediaDevice",
                "server",
                "gateway",
                "ipSwitchRouter",
                "vlanCloud",
                "videoAudioRouterMatrix",
                "encoderDecoder"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon Type"
        },
        "sdp_strategy": {
          "anyOf": [
            {
              "enum": [
                "always",
                "once",
                "video"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sdp Strategy"
        },
        "site_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Site Id"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "#/$defs/TagDelta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        }
      },
      "title": "DevicePatch",
      "type": "object"
    },
    "Field": {
      "additionalProperties": false,
      "description": "One naming fact: ``Field(\"endpoint.index\", format=\"02d\")`` or YAML ``{field: endpoint.index, format: 02d}``.\n\n``mapping`` translates the (stringified) value; ``prefix`` / ``suffix`` are only emitted when the\nvalue is present, so an absent optional field leaves no dangling separator text.",
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "mapping": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapping"
        },
        "prefix": {
          "default": "",
          "title": "Prefix",
          "type": "string"
        },
        "suffix": {
          "default": "",
          "title": "Suffix",
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "title": "Field",
      "type": "object"
    },
    "GenericSettings": {
      "additionalProperties": false,
      "description": "Generic connection settings (``cinfo.http``). ``http_auth`` is the server's raw\n``httpAuth`` mode code (``0`` disables HTTP authentication).",
      "properties": {
        "enable_https": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enable Https"
        },
        "http_auth": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Auth"
        },
        "trust_all_certificates": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trust All Certificates"
        }
      },
      "title": "GenericSettings",
      "type": "object"
    },
    "InventoryConfig": {
      "additionalProperties": false,
      "description": "One Inventory entry (``default`` or a named variant patch).",
      "properties": {
        "active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active"
        },
        "custom_settings": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Settings"
        },
        "driver_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Driver Id"
        },
        "generic_settings": {
          "anyOf": [
            {
              "$ref": "#/$defs/GenericSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "propertyNames": {
                "minLength": 1
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata"
        },
        "naming": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlueprintNaming"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "snmp": {
          "anyOf": [
            {
              "$ref": "#/$defs/SnmpSelection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "InventoryConfig",
      "type": "object"
    },
    "Join": {
      "additionalProperties": false,
      "description": "Join rendered parts with ``separator``. With ``skip_missing``, parts whose *optional* value is\nabsent are omitted; unknown fields, type errors, and failed mappings are still errors.",
      "properties": {
        "join": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/Text"
              },
              {
                "$ref": "#/$defs/Field"
              },
              {
                "$ref": "#/$defs/Join"
              }
            ]
          },
          "title": "Join",
          "type": "array"
        },
        "separator": {
          "default": "",
          "title": "Separator",
          "type": "string"
        },
        "skip_missing": {
          "default": false,
          "title": "Skip Missing",
          "type": "boolean"
        }
      },
      "required": [
        "join"
      ],
      "title": "Join",
      "type": "object"
    },
    "ModulePatch": {
      "additionalProperties": false,
      "description": "Module-local tag settings (module targets only).",
      "properties": {
        "tags": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "#/$defs/TagDelta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        }
      },
      "title": "ModulePatch",
      "type": "object"
    },
    "SnmpSelection": {
      "additionalProperties": false,
      "description": "Global SNMP selection. ``configuration`` is an exact label (string) or ``{id: ...}``.",
      "properties": {
        "configuration": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "$ref": "#/$defs/CatalogId"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration"
        },
        "use_global_settings": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Use Global Settings"
        }
      },
      "title": "SnmpSelection",
      "type": "object"
    },
    "TagDelta": {
      "additionalProperties": false,
      "description": "Additive tag change that preserves unrelated local tags. Tag references are exact catalog\ntag ids (for example ``Format~~V_1080p50``); the engine never creates catalog entries.",
      "properties": {
        "add": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Add",
          "type": "array"
        },
        "remove": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Remove",
          "type": "array"
        }
      },
      "title": "TagDelta",
      "type": "object"
    },
    "Text": {
      "additionalProperties": false,
      "description": "A literal text block: ``Text(\"-\")`` or YAML ``{text: \"-\"}``.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Text",
      "type": "object"
    },
    "TopologyConfig": {
      "additionalProperties": false,
      "description": "One topology entry (``default`` or a named variant patch).",
      "properties": {
        "device": {
          "anyOf": [
            {
              "$ref": "#/$defs/DevicePatch"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ip_vertex_mapping": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "propertyNames": {
                "minLength": 1
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ip Vertex Mapping"
        },
        "module": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModulePatch"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "naming": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlueprintNaming"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vertex_processor": {
          "anyOf": [
            {
              "$ref": "#/$defs/VertexProcessorSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vertices": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/VertexOverride"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vertices"
        }
      },
      "title": "TopologyConfig",
      "type": "object"
    },
    "VertexOverride": {
      "additionalProperties": false,
      "description": "Explicit vertex edit. Select by exact ``vertex_id``, or by exact ``factory_label`` (supports\n``{module.position}``) optionally restricted by ``kind`` / ``direction``; must match exactly one vertex.",
      "properties": {
        "direction": {
          "anyOf": [
            {
              "enum": [
                "In",
                "Out",
                "Internal",
                "Undecided"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "factory_label": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Factory Label"
        },
        "fields": {
          "$ref": "#/$defs/VertexPatch"
        },
        "kind": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "vertex_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vertex Id"
        }
      },
      "required": [
        "fields"
      ],
      "title": "VertexOverride",
      "type": "object"
    },
    "VertexPatch": {
      "additionalProperties": false,
      "description": "Supported vertex edits. ``\"\"`` is an explicit clear for label/description.\n\nKind-specific fields: ``sdp_support`` and the destination ports apply to codec vertices,\n``supports_static_igmp`` to IP vertices.",
      "properties": {
        "active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "main_destination_port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Main Destination Port"
        },
        "sdp_support": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sdp Support"
        },
        "sips_mode": {
          "anyOf": [
            {
              "enum": [
                "NONE",
                "SIPSAuto",
                "SIPSDuplicate",
                "SIPSMerge",
                "SIPSSplit"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sips Mode"
        },
        "spare_destination_port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spare Destination Port"
        },
        "supports_static_igmp": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supports Static Igmp"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "#/$defs/TagDelta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        },
        "use_as_endpoint": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Use As Endpoint"
        }
      },
      "title": "VertexPatch",
      "type": "object"
    },
    "VertexProcessorSpec": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "processor_type": {
                "const": "matrox.convertip.default"
              }
            },
            "required": [
              "processor_type"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "additionalProperties": false,
                "description": "Parameters. Omitted tag parameters leave local tags unchanged (``[]`` clears them); an omitted\n``redundant_streams`` preserves the SIPS mode (``true`` \u2192 ``SIPSAuto``, ``false`` \u2192 ``NONE``).",
                "properties": {
                  "allow_null_audio_label": {
                    "default": false,
                    "title": "Allow Null Audio Label",
                    "type": "boolean"
                  },
                  "audio_receiver_tags": {
                    "anyOf": [
                      {
                        "items": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "type": "array"
                      },
                      {
                        "$ref": "#/$defs/TagDelta"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Audio Receiver Tags"
                  },
                  "audio_sender_tags": {
                    "anyOf": [
                      {
                        "items": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "type": "array"
                      },
                      {
                        "$ref": "#/$defs/TagDelta"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Audio Sender Tags"
                  },
                  "configure_control": {
                    "default": false,
                    "title": "Configure Control",
                    "type": "boolean"
                  },
                  "mode": {
                    "default": "auto",
                    "enum": [
                      "auto",
                      "tx",
                      "rx",
                      "four_split"
                    ],
                    "title": "Mode",
                    "type": "string"
                  },
                  "redundant_streams": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Redundant Streams"
                  },
                  "video_receiver_tags": {
                    "anyOf": [
                      {
                        "items": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "type": "array"
                      },
                      {
                        "$ref": "#/$defs/TagDelta"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Video Receiver Tags"
                  },
                  "video_sender_tags": {
                    "anyOf": [
                      {
                        "items": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "type": "array"
                      },
                      {
                        "$ref": "#/$defs/TagDelta"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Video Sender Tags"
                  }
                },
                "title": "MatroxConvertIPParams",
                "type": "object"
              }
            }
          }
        }
      ],
      "description": "Processor declaration. ``processor_type`` may be inherited from ``default`` by a variant;\nit is required on the resolved configuration.",
      "properties": {
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "processor_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Processor Type"
        }
      },
      "title": "VertexProcessorSpec",
      "type": "object"
    }
  },
  "$id": "https://github.com/SWR-MoIP/VideoIPath-Automation-Tool/blueprint-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
